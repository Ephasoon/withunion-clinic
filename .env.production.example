# WithUnion Clinic - production settings for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# then fill in every value below. .env.production is git-ignored: never
# commit it, never send it by chat or e-mail. Values must not contain
# spaces or quotes.

# --- Web address --------------------------------------------------------
# The clinic's domain name, without https:// and without a trailing slash.
# Its DNS A record must point at this server's public IP before the first
# start, or Let's Encrypt cannot issue the certificate.
DOMAIN=

# E-mail address for the Let's Encrypt account (certificate expiry and
# problem notices).
ACME_EMAIL=

# --- Database -------------------------------------------------------------
# Name of the database and of the database user the API connects as.
POSTGRES_DB=withunion_clinic
POSTGRES_USER=withunion

# Database password. Use letters and digits only (it is placed inside a
# connection URL). Generate one with:  openssl rand -hex 32
# It is stored in the database volume at first start; changing it here
# later does NOT change it in the database (see docs/deployment.md).
POSTGRES_PASSWORD=

# --- Sessions -------------------------------------------------------------
# Signs the login cookies. At least 32 random characters; the API refuses
# to start without it. Generate with:  openssl rand -hex 48
# Changing it signs everyone out.
SESSION_SECRET=

# Optional. Cookie name and session length (milliseconds; 28800000 = 8 hours).
# SESSION_COOKIE_NAME=wu_clinic_sid
# SESSION_MAX_AGE_MS=28800000

# --- Login rate limit (optional) -----------------------------------------
# At most LOGIN_RATE_LIMIT_MAX login attempts per client address per
# LOGIN_RATE_LIMIT_WINDOW_MS (milliseconds; 900000 = 15 minutes).
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=10

# --- Logging (optional) ---------------------------------------------------
# One of fatal, error, warn, info, debug, trace.
# LOG_LEVEL=info

# --- Receipts -------------------------------------------------------------
# Printed at the top of every receipt.
CLINIC_NAME=WithUnion Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=

# --- Release tag (optional) -----------------------------------------------
# Tag given to the images built on this server, e.g. the git commit. Lets
# you keep the previous images for a quick rollback (docs/deployment.md).
# APP_VERSION=local
