# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://withunion:changeme@localhost:5432/withunion_clinic
# Separate database for the vitest suite — must end in _test. Locally this
# is a private test-only server on port 5433 (see README).
TEST_DATABASE_URL=postgres://withunion:changeme@localhost:5433/withunion_clinic_test

# Session
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-value
SESSION_COOKIE_NAME=wu_clinic_sid
SESSION_MAX_AGE_MS=28800000

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
